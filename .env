
# Environment
NEXT_PUBLIC_APP_ENV=development # development | staging | production

# RPC URLs
NEXT_PUBLIC_BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
NEXT_PUBLIC_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Block Explorers
NEXT_PUBLIC_BSCSCAN_URL=https://bscscan.com
NEXT_PUBLIC_BSCSCAN_TESTNET_URL=https://testnet.bscscan.com

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_id